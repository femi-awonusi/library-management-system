
{
  "info": {
    "_postman_id": "8b9a5d20-1f42-4d63-9e72-1a3f6c8b5d10",
    "name": "Library API - Week 2",
    "description": "Postman collection for Week 2: Authentication, Genres CRUD, Books CRUD, search, filtering, pagination, DTO validation and role-based authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "librarianToken",
      "value": ""
    },
    {
      "key": "patronToken",
      "value": ""
    },
    {
      "key": "genreId",
      "value": "1"
    },
    {
      "key": "bookId",
      "value": "1"
    },
    {
      "key": "patronEmail",
      "value": "newpatron@example.com"
    },
    {
      "key": "patronPassword",
      "value": "StrongPassword123"
    },
    {
      "key": "librarianEmail",
      "value": "librarian@example.com"
    },
    {
      "key": "librarianPassword",
      "value": "REPLACE_WITH_YOUR_LIBRARIAN_PASSWORD"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Patron\",\n  \"email\": \"{{patronEmail}}\",\n  \"password\": \"{{patronPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login as Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patronEmail}}\",\n  \"password\": \"{{patronPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login as Librarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{librarianEmail}}\",\n  \"password\": \"{{librarianPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Genre\"\n}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get Genre by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Genre\"\n}"
            },
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book (Librarian)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Postman Test Author\",\n  \"isbn\": \"9780000000001\",\n  \"totalCopies\": 5,\n  \"genreId\": {{genreId}}\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?search=Hobbit"
          }
        },
        {
          "name": "Filter Books by Genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId={{genreId}}"
          }
        },
        {
          "name": "Paginate Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?page=1&limit=5"
          }
        },
        {
          "name": "Update Book (Librarian)",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman Test Book\",\n  \"totalCopies\": 10\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete Book (Librarian)",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarianToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    }
  ]
}
