# Neon pooled connection for application queries and seeding
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"

# Application configuration
PORT=3000

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Initial librarian account
LIBRARIAN_EMAIL=librarian@example.com
LIBRARIAN_PASSWORD=replace_with_a_secure_password

# Neon direct connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
